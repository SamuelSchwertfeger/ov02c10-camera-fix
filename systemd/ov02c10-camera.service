[Unit]
Description=OV02C10 IPU6 camera (on-demand virtual webcam)
Documentation=https://github.com/SamuelSchwertfeger/ov02c10-camera-fix

# One always-on process. It keeps /dev/video48 visible as a camera at almost
# no cost and only powers the sensor while an application is streaming.
[Service]
ExecStart=/usr/bin/ov02c10-camera --on-demand
Restart=on-failure
RestartSec=3
# Safety net: a regression that leaks gets the service killed and restarted,
# one that spins gets throttled, instead of taking the machine down.
MemoryMax=256M
CPUQuota=150%

[Install]
WantedBy=default.target
